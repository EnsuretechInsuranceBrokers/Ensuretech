{
 "uid": "ensuretech",
 "title": "Ensuretech services",
 "tags": [
  "ensuretech"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "15s",
 "time": {
  "from": "now-30m",
  "to": "now"
 },
 "panels": [
  {
   "id": 1,
   "type": "stat",
   "title": "Services up",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(up{job=\"ensuretech-spring\"})"
    }
   ]
  },
  {
   "id": 2,
   "type": "stat",
   "title": "Requests / s (all services)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 6,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count[1m]))"
    }
   ]
  },
  {
   "id": 3,
   "type": "stat",
   "title": "5xx / s",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 12,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))"
    }
   ]
  },
  {
   "id": 4,
   "type": "stat",
   "title": "TPA offline lines saved (since start)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 18,
    "y": 0,
    "w": 6,
    "h": 4
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(ensuretech_offline_lines_total{outcome=~\"ASSIGNED|REASSIGNED|UPDATED\"})"
    }
   ]
  },
  {
   "id": 5,
   "type": "timeseries",
   "title": "Requests per second, by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service)(rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 6,
   "type": "timeseries",
   "title": "Average latency, by service",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service)(rate(http_server_requests_seconds_sum[1m])) / sum by (service)(rate(http_server_requests_seconds_count[1m]))",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 7,
   "type": "timeseries",
   "title": "Errors (4xx and 5xx per second)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 4,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service)(rate(http_server_requests_seconds_count{status=~\"4..\"}[1m]))",
     "legendFormat": "4xx {{service}}"
    },
    {
     "refId": "B",
     "expr": "sum by (service)(rate(http_server_requests_seconds_count{status=~\"5..\"}[1m]))",
     "legendFormat": "5xx {{service}}"
    }
   ]
  },
  {
   "id": 8,
   "type": "timeseries",
   "title": "JVM heap used",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "bytes"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service)(jvm_memory_used_bytes{area=\"heap\"})",
     "legendFormat": "{{service}}"
    }
   ]
  },
  {
   "id": 9,
   "type": "timeseries",
   "title": "Database connections in use",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "hikaricp_connections_active",
     "legendFormat": "active {{service}}"
    },
    {
     "refId": "B",
     "expr": "hikaricp_connections_pending",
     "legendFormat": "waiting {{service}}"
    }
   ]
  },
  {
   "id": 10,
   "type": "timeseries",
   "title": "TPA offline upload lines by outcome",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 16,
    "y": 12,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (outcome)(increase(ensuretech_offline_lines_total[5m]))",
     "legendFormat": "{{outcome}}"
    }
   ]
  },
  {
   "id": 11,
   "type": "timeseries",
   "title": "TPA offline upload time (average)",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 0,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "s"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum(rate(ensuretech_offline_upload_seconds_sum[5m])) / sum(rate(ensuretech_offline_upload_seconds_count[5m]))",
     "legendFormat": "seconds"
    }
   ]
  },
  {
   "id": 12,
   "type": "timeseries",
   "title": "Logged errors per second",
   "datasource": {
    "type": "prometheus",
    "uid": "prom"
   },
   "gridPos": {
    "x": 8,
    "y": 20,
    "w": 8,
    "h": 8
   },
   "fieldConfig": {
    "defaults": {
     "unit": "short"
    },
    "overrides": []
   },
   "targets": [
    {
     "refId": "A",
     "expr": "sum by (service)(rate(logback_events_total{level=\"error\"}[1m]))",
     "legendFormat": "log errors {{service}}"
    }
   ]
  }
 ]
}