# Ensuretech local environment.  Use it in EVERY terminal you start a component from, at the repo root:
#       set -a; source local.env; set +a
# Dev-only values. For anything shared or deployed, generate new secrets and never commit them.

export ENSURETECH_ROOT="${ENSURETECH_ROOT:-$PWD}"

# ── the shared secret: BFF sends it, every core service requires it (see run.html §7). Regenerate: php -r 'echo bin2hex(random_bytes(32));'
export GATEWAY_SECRET=1d83c3063a9b34a7b049b8b3b9c91ada2658e9daf69d195ca12c6d0f9476b94e
export BFF_GATEWAY_SECRET=$GATEWAY_SECRET

# ── infrastructure
export KAFKA_BOOTSTRAP_SERVERS=localhost:9092
export REDIS_HOST=localhost
export REDIS_PORT=6379
export MONGO_URI=mongodb://localhost:27017
export MONGO_DB=ensuretech_read
export SMTP_HOST=localhost
export SMTP_PORT=1025
export MAIL_FROM=no-reply@ensuretech.test

# ── database credentials (match setup.sql). DB_PORT: 5432 normally; 5433 if you run a SECOND PostgreSQL as a throwaway test database (run.html §3)
export DB_HOST=${DB_HOST:-localhost}
export DB_PORT=${DB_PORT:-5432}
export DATABASE_USER=ensuretech
export DATABASE_PASSWORD=ensuretech
# Spring services take a JDBC url; Django services take a postgres:// url. One variable per service, mapped to DATABASE_URL at launch (run.html).
export ORG_JDBC=jdbc:postgresql://${DB_HOST}:${DB_PORT}/ensuretech_org
export POLICY_JDBC=jdbc:postgresql://${DB_HOST}:${DB_PORT}/ensuretech_policy
export BILLING_JDBC=jdbc:postgresql://${DB_HOST}:${DB_PORT}/ensuretech_billing
export INTEGRATION_JDBC=jdbc:postgresql://${DB_HOST}:${DB_PORT}/ensuretech_integration
export SHEETGEN_JDBC=jdbc:postgresql://${DB_HOST}:${DB_PORT}/ensuretech_sheetgen
export IDENTITY_DB=postgres://ensuretech:ensuretech@${DB_HOST}:${DB_PORT}/ensuretech_identity
export ENDORSEMENT_DB=postgres://ensuretech:ensuretech@${DB_HOST}:${DB_PORT}/ensuretech_endorsement
export NOTIFICATION_DB=postgres://ensuretech:ensuretech@${DB_HOST}:${DB_PORT}/ensuretech_notification

# ── identity keys (generated once, run.html §4) and JWT settings
export JWT_ISSUER=ensuretech-identity
export JWT_PUBLIC_KEY_PATH=$ENSURETECH_ROOT/services/identity-service/keys/jwt-public.pem         # Django services, BFF
export JWT_PUBLIC_KEY_LOCATION=file:$JWT_PUBLIC_KEY_PATH                                           # Spring services
export BFF_JWT_PUBLIC_KEY_PATH=$JWT_PUBLIC_KEY_PATH
export DJANGO_SECRET_KEY=f669c9c73a49c4a318f6ea1a15e10b021e3c0ce0a0e9d910

# ── how services find each other
export IDENTITY_TOKEN_URL=http://localhost:8000/api/v1/auth/service-token/
export POLICY_GRPC_TARGET=localhost:9090
export BILLING_GRPC_TARGET=localhost:9091
export POLICY_SERVICE_URL=http://localhost:8082
export ENGINE_BASE_URL=http://localhost:8083
# Celery runs for real: workers consume the six queues, beat schedules the outbox relay, Flower shows it all (run.html §3a, §8.5).
# Broker: RabbitMQ when something answers on 5672 (the design: priority queues and dead-letter queues are RabbitMQ features), else Redis (works, but no dead-letter queues).
export CELERY_BROKER_URL=${CELERY_BROKER_URL:-redis://localhost:6379/1}      # scripts/dev-up.sh switches to  amqp://guest:guest@localhost:5672//  when RabbitMQ is up
export FLOWER_BASIC_AUTH=${FLOWER_BASIC_AUTH:-flower:flower-dev-only}        # user:password for the Flower dashboard on http://127.0.0.1:5555 (dev value)
# export CELERY_TASK_ALWAYS_EAGER=true   # the old shortcut: tasks run inline inside the web process, no worker, no Flower. Only with  scripts/dev-up.sh --eager

# ── service accounts for machine-to-machine calls. These are the one setup.sql creates (a development value, also printed in its header);
#    the engine and integration-service may share it. If you built databases_only=1, create your own (run.html §6.1) and put them here.
export ENGINE_CLIENT_ID=${ENGINE_CLIENT_ID:-svc_e3135bae0ed7b7b6}
export ENGINE_CLIENT_SECRET=${ENGINE_CLIENT_SECRET:-65-c-MbjEwBeCikrBCZRbSFNpRv6ZgRQbtFUMCfjMTam7wBNEiv4Chr_0faEUvTX}
export INTEGRATION_CLIENT_ID=${INTEGRATION_CLIENT_ID:-$ENGINE_CLIENT_ID}
export INTEGRATION_CLIENT_SECRET=${INTEGRATION_CLIENT_SECRET:-$ENGINE_CLIENT_SECRET}

# ── optional
export ANSWERER=extractive                       # "claude" needs ANTHROPIC_API_KEY (paid); extractive is free
# export ANTHROPIC_API_KEY=

# ── metrics (run.html §16): the one read-only credential a metrics scraper uses on GET /actuator/prometheus of the Spring services. Dev value; regenerate for anything shared.
export METRICS_TOKEN=${METRICS_TOKEN:-7c1f0b52d9e84a63b0a5e1c47d28f69a3b5c10e8d47f92a6}

# ── operations console (admin-service, http://127.0.0.1:8100: Spring Boot Admin + the Jobs page) and the job-killer password. Dev values; change for anything shared.
export ADMIN_UI_USER=${ADMIN_UI_USER:-admin}
export ADMIN_UI_PASSWORD=${ADMIN_UI_PASSWORD:-console-dev-password-1}
# hashed into integration's database on its first start; change it afterwards with PUT /api/v1/ops/jobs/password (the Jobs page and scripts/jobctl.sh never store it)
export JOB_KILLER_BOOTSTRAP_PASSWORD=${JOB_KILLER_BOOTSTRAP_PASSWORD:-job-killer-dev-pw-1}

# ── query log (development X-ray, console page /queries.html behind the ADMIN_UI_USER / ADMIN_UI_PASSWORD login above): each Spring service records every request's controller method and SQL.
# Keeps SQL text (never bind values) in memory: leave it OFF anywhere shared. Set to false to switch it off.
export QUERYLOG_ENABLED=${QUERYLOG_ENABLED:-true}

# ── private values that must never be committed (docs/break-glass.md): BREAK_GLASS_PASSWORD and its throttle. Create local.env.private next to this file; it is in .gitignore.
[ -f "$ENSURETECH_ROOT/local.env.private" ] && . "$ENSURETECH_ROOT/local.env.private"
