DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# Same PostgreSQL database as every other service; this service's tables live in the `endorsement` schema.
DATABASE_URL=postgres://ensuretech:ensuretech@localhost:5432/ensuretech
CELERY_BROKER_URL=amqp://guest:guest@localhost:5672//
REDIS_URL=redis://localhost:6379/1
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
# identity-service public key (RS256). Tokens must be access tokens from this issuer.
JWT_PUBLIC_KEY_PATH=../identity-service/keys/jwt-public.pem
JWT_ISSUER=ensuretech-identity
# policy-service gRPC
POLICY_GRPC_TARGET=localhost:9090
POLICY_GRPC_TOKEN=            # SYSTEM service-account JWT used for calls on behalf of a job
# billing-service is not built yet: the CD check stays unavailable until it exists
CD_CLIENT=apps.computation.cd.UnavailableCdClient
MAX_UPLOAD_ROWS=1000000
CHUNK_TARGET_ROWS=500
