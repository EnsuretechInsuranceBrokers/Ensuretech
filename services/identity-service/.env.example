DJANGO_SECRET_KEY=change-me
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
# PostgreSQL (same database as the other services; own tables live in the `identity` schema)
DATABASE_URL=postgres://ensuretech:ensuretech@localhost:5432/ensuretech
# RS256 keypair. Leave unset in dev to auto-generate keys/ (gitignored).
JWT_PRIVATE_KEY_PATH=keys/jwt-private.pem
JWT_PUBLIC_KEY_PATH=keys/jwt-public.pem
JWT_ISSUER=ensuretech-identity
JWT_ACCESS_MINUTES=15
JWT_REFRESH_DAYS=7
CORS_ALLOWED_ORIGINS=http://localhost:3000
