APP_NAME=ensuretech-bff
APP_ENV=local
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8090

LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=info

# The API is stateless. Only the built-in portal (/login, /app) keeps a server-side session, holding the user's tokens (encrypted at rest, never sent to the browser).
# Rate-limit counters live in the cache. With more than one BFF instance use redis for both.
SESSION_DRIVER=file
SESSION_ENCRYPT=true
SESSION_SAME_SITE=strict
SESSION_SECURE_COOKIE=false   # true behind TLS
CACHE_STORE=file
QUEUE_CONNECTION=sync
DB_CONNECTION=null

BFF_JWT_PUBLIC_KEY_PATH=../identity-service/keys/jwt-public.pem
BFF_JWT_ISSUER=ensuretech-identity

BFF_CORS_ORIGINS=
UPSTREAM_IDENTITY=http://localhost:8000
UPSTREAM_ORGANIZATION=http://localhost:8081
UPSTREAM_POLICY=http://localhost:8082
UPSTREAM_ENDORSEMENT=http://localhost:8083
UPSTREAM_BILLING=http://localhost:8084
UPSTREAM_INTEGRATION=http://localhost:8085
UPSTREAM_READ=http://localhost:8087
UPSTREAM_SHEETS=http://localhost:8086
BFF_QA_TOOLS=false

# Shared secret proving a call came from this BFF. Same value as GATEWAY_SECRET in every core service. Generate: php -r 'echo bin2hex(random_bytes(32));'
BFF_GATEWAY_SECRET=

# Local debugging only (never on a server; composer install --no-dev does not even install them). scripts/dev-up.sh switches them on for you.
TELESCOPE_ENABLED=false     # Laravel Telescope at /telescope (local APP_ENV only)
RAY_ENABLED=false           # Ray desktop app (myray.app): ray('x') in PHP, and requests / outgoing calls / logs shown automatically
